{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/travel-eval/decision.schema.json",
  "title": "Disruption Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "candidate_id", "trip_id", "leg_id", "decided_at",
    "verdict", "reason_codes", "policy_version", "confidence", "cooldown_until"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "trip_id": {"type": "string"},
    "leg_id": {"type": "string"},
    "decided_at": {"type": "string", "format": "date-time"},
    "verdict": {"enum": ["SUPPRESS", "NOTIFY", "NOTIFY_AND_SEARCH"]},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "policy_version": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "cooldown_until": {"type": "string", "format": "date-time"}
  }
}
