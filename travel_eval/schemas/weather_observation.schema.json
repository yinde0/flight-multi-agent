{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/travel-eval/weather_observation.schema.json",
  "title": "Normalized Airport Weather Forecast",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "observation_id", "observed_at", "source", "airport",
    "latitude", "longitude", "target_at", "forecast_at", "condition_code",
    "condition", "description", "risk_level", "alerts",
    "precipitation_probability", "wind_speed_mps", "visibility_metres",
    "confidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "observation_id": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string"},
    "airport": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "target_at": {"type": "string", "format": "date-time"},
    "forecast_at": {"type": "string", "format": "date-time"},
    "condition_code": {"type": "integer", "minimum": 0},
    "condition": {"type": "string"},
    "description": {"type": "string"},
    "risk_level": {"enum": ["none", "low", "moderate", "high", "severe"]},
    "alerts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "precipitation_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "wind_speed_mps": {"type": "number", "minimum": 0},
    "visibility_metres": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
