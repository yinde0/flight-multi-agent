{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/travel-eval/flight_search_command.schema.json",
  "title": "Post-Eval Read-Only Flight Search Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "search_id", "idempotency_key", "trip_id", "leg_id",
    "original_flight_iata", "origin", "destination", "departure_date",
    "earliest_departure_at", "latest_departure_at", "maximum_stops",
    "minimum_connection_minutes", "passenger_count", "cabin_class", "approval"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "search_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "trip_id": {"type": "string", "minLength": 1},
    "leg_id": {"type": "string", "minLength": 1},
    "original_flight_iata": {"type": "string", "pattern": "^[A-Z0-9]{2,3}[0-9]{1,4}$"},
    "origin": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "destination": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "departure_date": {"type": "string", "format": "date"},
    "earliest_departure_at": {"type": "string", "format": "date-time"},
    "latest_departure_at": {"type": "string", "format": "date-time"},
    "maximum_stops": {"type": "integer", "minimum": 0, "maximum": 2},
    "minimum_connection_minutes": {"type": "integer", "minimum": 0, "maximum": 240},
    "passenger_count": {"type": "integer", "minimum": 1, "maximum": 9},
    "cabin_class": {"enum": ["economy", "premium_economy", "business", "first"]},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "decision_id", "verdict", "policy_version", "reason_codes", "decided_at"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "decision_id": {"type": "string", "minLength": 1},
        "verdict": {"const": "NOTIFY_AND_SEARCH"},
        "policy_version": {"type": "string", "minLength": 1},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "decided_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
