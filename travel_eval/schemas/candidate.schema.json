{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/travel-eval/candidate.schema.json",
  "title": "Disruption Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "delta", "trip_id", "leg_id", "observed_at",
    "category", "delay_minutes", "connection_buffer_minutes", "minimum_connection_minutes",
    "weather_risk_level", "confidence", "score", "evidence_observation_ids"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "candidate_id": {"type": "string"},
    "delta": {"$ref": "delta.schema.json"},
    "trip_id": {"type": "string"},
    "leg_id": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "category": {
      "enum": [
        "CANCELLATION", "DIVERSION", "CONNECTION_RISK", "DELAY", "GATE_CHANGE",
        "TERMINAL_CHANGE", "WEATHER_RISK", "STATUS_CHANGE"
      ]
    },
    "delay_minutes": {"type": "integer", "minimum": 0},
    "connection_buffer_minutes": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
    "minimum_connection_minutes": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "weather_risk_level": {"enum": ["unknown", "none", "low", "moderate", "high", "severe"]},
    "weather_evidence_status": {"enum": ["available", "unavailable"]},
    "corroborated_by_weather": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_observation_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}}
  }
}
