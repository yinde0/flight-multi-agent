{
  "schema_version": "1.0.0",
  "policy_version": "1.2.0",
  "effective_from": "2026-08-25T00:00:00Z",
  "description": "Deterministic flight-impact policy with advisory weather corroboration.",
  "thresholds": {
    "delay_minutes": {
      "notify": 30,
      "search": 90
    },
    "default_minimum_connection_minutes": 45,
    "cooldown_minutes": 60
  },
  "ordered_rules": [
    {
      "rule_id": "P001",
      "when": "category == CANCELLATION",
      "verdict": "NOTIFY_AND_SEARCH",
      "reason_code": "FLIGHT_CANCELLED"
    },
    {
      "rule_id": "P002",
      "when": "category == DIVERSION",
      "verdict": "NOTIFY_AND_SEARCH",
      "reason_code": "FLIGHT_DIVERTED"
    },
    {
      "rule_id": "P003",
      "when": "connection_buffer_minutes < minimum_connection_minutes",
      "verdict": "NOTIFY_AND_SEARCH",
      "reason_code": "CONNECTION_BELOW_MINIMUM"
    },
    {
      "rule_id": "P004",
      "when": "delay_minutes >= 90",
      "verdict": "NOTIFY_AND_SEARCH",
      "reason_code": "DELAY_SEARCH_THRESHOLD"
    },
    {
      "rule_id": "P005",
      "when": "delay_minutes >= 30",
      "verdict": "NOTIFY",
      "reason_code": "DELAY_NOTIFY_THRESHOLD"
    },
    {
      "rule_id": "P006",
      "when": "category == GATE_CHANGE",
      "verdict": "SUPPRESS",
      "reason_code": "GATE_ONLY_CHANGE"
    },
    {
      "rule_id": "P006B",
      "when": "category == TERMINAL_CHANGE",
      "verdict": "SUPPRESS",
      "reason_code": "TERMINAL_ONLY_CHANGE"
    },
    {
      "rule_id": "P007",
      "when": "category == WEATHER_RISK and weather_risk_level in [high, severe]",
      "verdict": "SUPPRESS",
      "reason_code": "WEATHER_UNCORROBORATED"
    },
    {
      "rule_id": "P008",
      "when": "category == WEATHER_RISK and weather_risk_level in [low, moderate]",
      "verdict": "SUPPRESS",
      "reason_code": "MINOR_WEATHER_ONLY"
    },
    {
      "rule_id": "P009",
      "when": "category == WEATHER_RISK and weather_risk_level == none",
      "verdict": "SUPPRESS",
      "reason_code": "WEATHER_CLEARED"
    },
    {
      "rule_id": "P010",
      "when": "verdict != SUPPRESS and corroborated_by_weather == true",
      "verdict_effect": "UNCHANGED",
      "reason_code": "SEVERE_WEATHER_CORROBORATED"
    },
    {
      "rule_id": "P011",
      "when": "severity_band <= highest_notified_band for episode",
      "verdict": "SUPPRESS",
      "reason_code": "DUPLICATE_SEVERITY_BAND"
    }
  ],
  "safety_invariants": [
    "A suppressed decision cannot create a notification.",
    "Only NOTIFY_AND_SEARCH may create a rebooking search request.",
    "No policy decision authorizes booking, cancellation, or payment.",
    "Every non-suppressed action carries an idempotency key and policy version."
  ]
}
