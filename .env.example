# Required only when an uploaded PDF has no machine-readable text layer.
MISTRAL_API_KEY=

# Optional Mistral OCR overrides.
MISTRAL_OCR_BASE_URL=https://api.mistral.ai/v1
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_OCR_TIMEOUT_SECONDS=60

# Slice 11 CrewAI Eval reasoning. The normal stack defaults to off. Enable the
# shadow overlay to compare structured model advice with deterministic policy;
# the model never authorizes notification, search, booking, cancellation, or payment.
EVAL_REASONING_MODE=off
EVAL_REASONING_MODEL=mistral/mistral-small-latest
EVAL_REASONING_TIMEOUT_SECONDS=45
EVAL_REASONING_MAX_TOKENS=700

# Used by vertical slice 03 for live flight-status reads.
AviationStack_API_KEY=

# Used by vertical slice 04 for live 5-day / 3-hour forecasts.
OpenWeatherMap_API_KEY=

# Optional OpenWeather overrides.
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_TIMEOUT_SECONDS=30

# Optional AviationStack overrides.
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1
AVIATIONSTACK_TIMEOUT_SECONDS=30
# Keep false for real-time/free-plan polling; enable only for a subscription
# that supports date-filtered historical/future flight access.
AVIATIONSTACK_INCLUDE_FLIGHT_DATE_FILTER=false

# Used by vertical slice 06 for priced, expiring flight offers. Duffel test
# tokens produce provider_test_offers; production live-mode tokens produce
# live_offers. Neither mode authorizes booking.
DUFFEL_TOKEN=

# Optional Duffel overrides. The golden Docker overlay sets replay by itself.
FLIGHT_SEARCH_PROVIDER=duffel
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_TIMEOUT_SECONDS=30
DUFFEL_SUPPLIER_TIMEOUT_MS=10000
DUFFEL_MAX_OFFERS=100

# RDS/Postgres-compatible itinerary persistence. Docker uses these local
# defaults; production should inject managed-database credentials securely.
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel-local
POSTGRES_DB=travel

# Local S3-compatible development storage. Production can replace S3_ENDPOINT_URL
# and these credentials with AWS workload identity and a real S3 bucket.
MINIO_ROOT_USER=travel-local
MINIO_ROOT_PASSWORD=travel-local-secret
ITINERARY_BUCKET_NAME=travel-itineraries

# Automatic monitoring scheduler. Manual clock control remains disabled in the
# normal stack and is enabled only by the Slice 07 evaluation overlay.
SCHEDULER_BACKGROUND_ENABLED=true
SCHEDULER_CONTROL_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=30
SCHEDULER_LEASE_SECONDS=120

# Durable event delivery. The normal defaults retain JetStream events for 14
# days, deduplicate a publisher event ID for 10 minutes, and retry outboxes
# every two seconds.
EVENT_STREAM_MAX_AGE_SECONDS=1209600
EVENT_STREAM_DUPLICATE_WINDOW_SECONDS=600
EVENT_PUBLISH_TIMEOUT_SECONDS=5
EVENT_ACK_WAIT_SECONDS=30
EVENT_MAX_DELIVERIES=5
EVENT_MAX_ACK_PENDING=100
EVENT_RETRY_DELAY_SECONDS=2
OUTBOX_RETRY_INTERVAL_SECONDS=2

# Slice 09 operations and observability. Operator routes stay disabled when the
# token is empty. Trace export and CrewAI instrumentation are opt-in and must
# never include document, OCR, traveler, or provider content.
OPS_API_TOKEN=
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORT_TIMEOUT_SECONDS=2
CREWAI_OTEL_ENABLED=false
# Content capture is ignored unless DEPLOYMENT_ENVIRONMENT=development. Enable
# only while running synthetic or appropriately redacted development evidence.
OTEL_TRACE_CONTENT_ENABLED=false
OTEL_TRACE_CONTENT_MAX_CHARS=12000
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=flight-multi-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional full OTLP override for unusual self-hosted routing. Normally leave
# empty so Compose derives it from LANGSMITH_ENDPOINT.
LANGSMITH_OTEL_ENDPOINT=

# Required only when compose.observability.yaml is enabled.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Customer-facing Streamlit experience. The UI talks only to travel-api and
# receives no provider credentials.
TRAVEL_UI_PORT=8501
TRAVEL_UI_API_TIMEOUT_SECONDS=150
